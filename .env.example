# After Eternity — contact form mail settings (Next.js).
# Copy this file to .env.local and fill in real values (see config.php in the
# original static site for the live credentials).

SMTP_HOST="node616.namehero.net"
SMTP_PORT="465"
SMTP_USER="info@mailer.after-eternity.com"
SMTP_PASS="replace-with-your-mailbox-password"

FROM_EMAIL="info@mailer.after-eternity.com"
FROM_NAME="After Eternity Contact Form"

# Comma-separated list of addresses that receive new leads.
RECIPIENTS="mujtabafilms@gmail.com,mustafamir6666@gmail.com"

# Systeme.io public API key — generate one in your account under
# Settings > MCP & API keys. Sent as the X-API-Key header; each lead is
# created as a contact (best-effort, never blocks the form submission).
SYSTEME_API_KEY="replace-with-your-systeme-io-api-key"

# Optional: tag ID to assign to each new lead (numeric).
SYSTEME_TAG_ID=""

# Google Ads / GA4 (public vars, inlined at build time — safe to commit, they
# are not secrets). Full tag ID e.g. "AW-1234567890" from Ads > Tools > Conversions.
NEXT_PUBLIC_AW_CONVERSION_ID=""
# Conversion action labels, e.g. "AbCdEfGh" — from each conversion action's tag snippet.
NEXT_PUBLIC_AW_CONVERSION_LABEL=""
NEXT_PUBLIC_AW_CALL_LABEL=""
# GA4 measurement ID e.g. "G-XXXXXXXXXX" (optional).
NEXT_PUBLIC_GA4_ID=""
# Google Tag Manager container.
NEXT_PUBLIC_GTM_ID="GTM-W4JLDHQM"
